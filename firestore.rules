// ─────────────────────────────────────────────────────────────────────────────
// firestore.rules  —  MediHub Security Rules
// Deploy with:  firebase deploy --only firestore:rules
// ─────────────────────────────────────────────────────────────────────────────
//
// RULE SUMMARY:
//  • A logged-in patient can ONLY read/write their own data (users/{theirUID}/...)
//  • No patient can ever see another patient's records
//  • Hospital admin writes (medications, appointments, profile fields) must be
//    done from the Firebase Console or a trusted server-side admin SDK
//    (Admin SDK bypasses these rules by design)
// ─────────────────────────────────────────────────────────────────────────────

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────────────────────

    // Is the requesting user logged in?
    function isLoggedIn() {
      return request.auth != null;
    }

    // Is the requesting user the owner of this document?
    function isOwner(userId) {
      return isLoggedIn() && request.auth.uid == userId;
    }

    // ── User profile document ───────────────────────────────────────────────
    match /users/{userId} {

      // Patient can read their own profile
      allow read: if isOwner(userId);

      // Patient can only update their own EDITABLE fields
      // (DOB, phone, address, emergency contact, privacyAccepted)
      // Hospital fields (gender, bloodGroup, hospitalId, etc.) are NOT listed
      // here — they can only be written by the Admin SDK (hospital portal)
      allow create: if isOwner(userId)
                    && request.resource.data.keys().hasAll([
                        'fullName', 'email', 'privacyAccepted'
                       ]);

      allow update: if isOwner(userId)
                    && request.resource.data.diff(resource.data)
                       .affectedKeys()
                       .hasOnly([
                         'dateOfBirth',
                         'phoneNumber',
                         'address',
                         'emergencyContactName',
                         'emergencyContactNumber',
                         'privacyAccepted',
                         'photoUrl',
                         'fullName'
                       ]);

      // ── Medications sub-collection ───────────────────────────────────────
      match /medications/{medicationId} {
        // Patient can read their own medications
        allow read: if isOwner(userId);

        // Patient can ONLY update the takenStatus field
        // (marking a dose as taken — everything else is set by hospital)
        allow update: if isOwner(userId)
                      && request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['takenStatus']);

        // Only Admin SDK (hospital portal) can create/delete medications
        allow create, delete: if false;
      }

      // ── Appointments sub-collection ──────────────────────────────────────
      match /appointments/{appointmentId} {
        // Patient can read their own appointments
        allow read: if isOwner(userId);

        // Patient can ONLY update reschedule-related fields
        allow update: if isOwner(userId)
                      && request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly([
                           'rescheduleStatus',
                           'rescheduleRequestedAt',
                           'rescheduleNote'
                         ]);

        // Only Admin SDK (hospital portal) can create/delete appointments
        allow create, delete: if false;
      }

      // ── Daily Check-Ins sub-collection ───────────────────────────────────
      match /checkIns/{checkInId} {
        // Patient can read their own check-ins
        allow read: if isOwner(userId);

        // Patient can create a new check-in
        allow create: if isOwner(userId)
                      && request.resource.data.keys().hasAll([
                           'userId', 'date', 'symptoms',
                           'healthStatus', 'submittedToDoctor'
                         ])
                      && request.resource.data.userId == userId;

        // Patient can update their own check-in (e.g. edit symptoms)
        allow update: if isOwner(userId);

        // Check-ins are permanent — cannot be deleted by patient
        allow delete: if false;
      }
    }

    // ── Deny all other paths ────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
